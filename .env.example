# OCR v1 service settings. Every role composes these `OCR_*` variables
# (`app/ocr_api.py`, `app/ocr_worker.py`, `app/ocr_reconcile.py`,
# `app/ocr_cleanup.py`); see README.md and docs/ocr-v1-contracts.md §8.
#
# Development/testing target (docs/ocr-v1-dispatch.md). These are the intended
# values, not verified facts: no service is deployed, no IAM grant has been made,
# and nothing below has been exercised against the deployed roles.

# --- Target ---
OCR_PROJECT=thaiunion-ai-platform
OCR_REGION=asia-southeast1
# Durable state, in its own project (defaults to OCR_PROJECT when unset).
OCR_BUCKET=dev-ocr-service-data-asse1-1022222817897
OCR_BUCKET_PROJECT=thaiunion-shared-sandbox

# --- API role ---
# `OCR_API_AUDIENCE` is the deployed service URL: the in-app verifier re-verifies
# the caller's ID token against this exact audience and rejects any other.
OCR_API_AUDIENCE=https://REPLACE-WITH-DEPLOYED-SERVICE-URL
# Verified principal -> internal team id. Never derived from a request header,
# path, query, or body. A caller absent from this map is 403 `team_not_authorized`.
# Each key binds BOTH verified claims as `<email>|<subject>`: an allowlisted email
# presented with another subject is unauthorized, so a reused address cannot
# borrow a team. The subject is the ID token's numeric `sub`; look it up from the
# caller's verified token rather than guessing. A malformed key fails at startup.
OCR_TEAMS={"tu-ai-n8n-dev-runner-sa@thaiunion-ai-platform.iam.gserviceaccount.com|110367093326452748988": "team-dev"}

# --- Operator pin for newly accepted jobs (§8) ---
# The worker image must be an immutable `sha256:` digest; a tag is refused at
# startup. `OCR_WORKER_JOB_NAME` is one Cloud Run Job per revision and defaults to
# `dev-ocr-service-worker-<first 12 hex of the digest>` when unset.
OCR_WORKER_REVISION_DIGEST=sha256:REPLACE-WITH-THE-WORKER-IMAGE-DIGEST
OCR_WORKER_JOB_NAME=
OCR_WORKER_CONTAINER_NAME=worker
OCR_TASK_TIMEOUT_S=1800
OCR_TASK_MAX_RETRIES=0
OCR_CLEANUP_SCHEDULE_PERIOD_S=900
# `OCR_WORKER_ARGS` is a JSON string array and `OCR_WORKER_ENV` a JSON array of
# `[name, value]` pairs; both default to empty, which is what the deployed worker
# uses (`python -m app.ocr_worker`, with `OCR_JOB_TEAM_ID`/`OCR_JOB_ID` delivered
# as dispatch overrides).

# --- Engine (issue #7 provisional selection) ---
# The Tesseract `tha+eng` adapter is the measured DEV selection, not an approved
# production engine. A worker refuses to build it unless this explicit opt-in is
# set; leave it false (the default) outside a DEV environment.
OCR_ALLOW_PROVISIONAL_ENGINE=false
OCR_ENGINE_LANG=tha+eng
OCR_ENGINE_RASTER_DPI=300
