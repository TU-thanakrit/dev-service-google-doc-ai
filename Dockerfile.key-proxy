FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir --requirement requirements.txt

COPY app ./app

# Nonroot runtime. No fallback startup path: the facade is the only process.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin keyproxy
USER 10001

# exec so uvicorn is PID 1 and receives SIGTERM for a clean shutdown.
CMD ["sh", "-c", "exec uvicorn app.ocr_key_proxy_entrypoint:app --host 0.0.0.0 --port ${PORT}"]
