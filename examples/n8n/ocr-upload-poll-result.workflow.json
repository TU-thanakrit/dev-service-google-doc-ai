{
  "name": "OCR v1 upload -> poll -> result (inactive, unverified import)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "0a000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "0a000000-0000-4000-8000-000000000002",
              "name": "serviceUrl",
              "value": "https://REPLACE-WITH-DEPLOYED-SERVICE-URL",
              "type": "string"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000003",
              "name": "documentPath",
              "value": "/data/incoming/document.pdf",
              "type": "string"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000004",
              "name": "idempotencyKey",
              "value": "={{ 'ocr-' + $execution.id + '-1' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000005",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-340, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/identity?audience={{ encodeURIComponent($json.serviceUrl) }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Metadata-Flavor",
              "value": "Google"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "0a000000-0000-4000-8000-000000000006",
      "name": "Get identity token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Config').item.json.documentPath }}",
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000007",
      "name": "Read document",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.serviceUrl + '/v1/ocr/jobs' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get identity token').item.json.data }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').item.json.idempotencyKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000008",
      "name": "Submit document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "0a000000-0000-4000-8000-000000000009",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [540, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.serviceUrl + '/v1/ocr/jobs/' + $('Submit document').item.json.job_id }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get identity token').item.json.data }}"
            }
          ]
        },
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000010",
      "name": "Get status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0a000000-0000-4000-8000-000000000011",
              "leftValue": "={{ ['succeeded', 'partially_succeeded', 'failed'].includes($json.state) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000012",
      "name": "Job final?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [980, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.serviceUrl + '/v1/ocr/jobs/' + $('Submit document').item.json.job_id + '/result' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get identity token').item.json.data }}"
            }
          ]
        },
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000013",
      "name": "Get result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -100]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "0a000000-0000-4000-8000-000000000014",
              "name": "job_id",
              "value": "={{ $json.job_id }}",
              "type": "string"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000015",
              "name": "state",
              "value": "={{ $json.state }}",
              "type": "string"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000016",
              "name": "reason",
              "value": "={{ $json.reason }}",
              "type": "string"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000017",
              "name": "completeness",
              "value": "={{ $json.completeness }}",
              "type": "string"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000018",
              "name": "page_count",
              "value": "={{ $json.page_count }}",
              "type": "number"
            },
            {
              "id": "0a000000-0000-4000-8000-000000000019",
              "name": "warnings",
              "value": "={{ $json.warnings }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "0a000000-0000-4000-8000-000000000020",
      "name": "Result summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1420, -100]
    }
  ],
